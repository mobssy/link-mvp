{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "shouldTranslate": false
    },
    "App Lock is on. Open the app to unlock it first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de la app está activado. Ábrela primero para desbloquearla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリロックがオンです。先にアプリを開いてロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잠금이 켜져 있어요. 먼저 앱을 열어 잠금을 해제해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用锁已开启。请先打开应用解锁。"
          }
        }
      }
    },
    "Chat": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天"
          }
        }
      }
    },
    "Message": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        }
      }
    },
    "Send ${message} to ${chat}": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar ${message} a ${chat}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${chat}に${message}を送信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${chat}에 ${message} 보내기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向${chat}发送${message}"
          }
        }
      }
    },
    "Send Message": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar mensaje"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを送信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 보내기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送消息"
          }
        }
      }
    },
    "Sends a message to one of your chats.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje a uno de tus chats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのひとつにメッセージを送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅방 중 한 곳에 메시지를 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向你的某个聊天发送消息。"
          }
        }
      }
    },
    "Sent to %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 보냈어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送到%@。"
          }
        }
      }
    },
    "Sign in to the app first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero inicia sesión en la app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にアプリにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 앱에 로그인해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录应用。"
          }
        }
      }
    },
    "Summarize ${chat}": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumir ${chat}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${chat}を要約"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${chat} 요약"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总结${chat}"
          }
        }
      }
    },
    "Summarize Chat": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumir chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを要約"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 요약"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总结聊天"
          }
        }
      }
    },
    "Summarizes a chat on device with Apple Intelligence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume un chat en el dispositivo con Apple Intelligence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のApple Intelligenceでチャットを要約します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 안의 Apple Intelligence로 채팅을 요약합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设备上的 Apple Intelligence 总结聊天。"
          }
        }
      }
    },
    "That chat isn't in the app anymore.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese chat ya no está en la app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのチャットはもうありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 채팅방은 더 이상 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该聊天已不存在。"
          }
        }
      }
    },
    "There's nothing to send.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que enviar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送る内容がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 내용이 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可发送的内容。"
          }
        }
      }
    },
    "What should I send?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué envío?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何と送りますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뭐라고 보낼까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要发送什么？"
          }
        }
      }
    },
    "Which chat?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué chat?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのチャットですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 채팅방인가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪个聊天？"
          }
        }
      }
    }
  },
  "version": "1.0"
}
